# Copy to .env and edit. Every value is optional.

# Password for the YouTube login page (/auth/youtube). Leave empty to disable that page.
ADMIN_TOKEN=

# Hosts (and subdomains) the API will fetch. Keep in line with the mod's allowedHosts.
ALLOWED_HOSTS=youtube.com,youtu.be,discordapp.com,discordapp.net,tver.jp,cctv.com,cntv.cn,cntv.com,bilibili.com,b23.tv,iwara.tv

# Most MB of clients' playback diagnostics (POST /diagnostics) kept in /data/diagnostics.jsonl; ADMIN_TOKEN reads them
# at GET /diagnostics. Delete the file to start over.
DIAGNOSTICS_MAX_MB=200

# Minutes between YouTube cookie refreshes.
COOKIE_REFRESH_MINUTES=60

# Concurrent streams (one per in-game listener).
MAX_STREAMS=32

# Hours between yt-dlp updates (checked at start too). After an update the API restarts once no stream is
# playing. 0 turns it off.
YTDLP_UPDATE_HOURS=24

# Seconds a resolved media URL is reused.
RESOLVE_CACHE_SECONDS=1800

# Optional extension that plays pages this API does not (see README).
EXTENSION_URL=
EXTENSION_TOKEN=
# Where players reach the extension; its pages' /video and /stream redirect there.
EXTENSION_PUBLIC_URL=

# Direct P2P between players (see README). A long random secret shared only with the Minecraft server's mod, never
# with players. Leave empty to disable /p2p.
P2P_SERVER_TOKEN=
# Comma-separated stun: URLs players use to find their public address. Empty is fine on a LAN. TURN is not supported.
P2P_STUN_URLS=
